{
  "routes": [
    {
      "src": "/api/(company-holidays|employee-request|intern-decision|intern-terms|leave-evidence|leave-policy|registration)/?",
      "dest": "/api/[policy]"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/api/.*",
      "status": 404
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ]
}
