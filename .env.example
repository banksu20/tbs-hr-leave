# Browser (compiled into the public bundle - never put secrets here)
VITE_N8N_WEBHOOK_URL=https://n8n.womenrefugeeroute.org
VITE_LIFF_ID=
VITE_CEO_USER_ID=
VITE_API_BASE_URL=

# Server only (Vercel environment variables)
N8N_WEBHOOK_URL=https://n8n.womenrefugeeroute.org
N8N_TIMEOUT_MS=15000
# Initial Admin setup only: a new private 8–128 character password.
# First sign-in as admin bootstraps only when there are no dashboard accounts.
# Remove this variable after creating the Admin account; never use a VITE_ prefix.
DASHBOARD_BOOTSTRAP_PASSWORD=

# Shared only between the app server and the n8n Header Auth credential.
# n8n header name: x-ceo-webhook-secret. Never prefix this with VITE_.
CEO_WEBHOOK_SECRET=
# Alternatively use ceowebhook (lowercase), matching the Vercel setting.
# If both are set, CEO_WEBHOOK_SECRET takes precedence.
ceowebhook=
